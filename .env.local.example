# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Or use the legacy anon JWT key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Legacy service role JWT or new secret key (sb_secret_...) — optional for most features.
# Staff provisioning uses a secure database function and does not require this key.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_SECRET_KEY=your-supabase-secret-key

# Authentication
NEXTAUTH_SECRET=your-nextauth-secret-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Payment Gateways
# JazzCash
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_INTEGRITY_SALT=your-jazzcash-integrity-salt

# EasyPaisa
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_HASH_KEY=your-easypaisa-hash-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Notifications
# Email (Resend) — get key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# From must be on a Resend-verified domain. Gmail cannot be used as From.
# Testing: Apna Clinic <onboarding@resend.dev>
# Production (after verifying your domain): Apna Clinic <noreply@apnaclinic.pk>
RESEND_FROM=Apna Clinic <onboarding@resend.dev>
# Replies go to the clinic inbox (Gmail is fine here)
RESEND_REPLY_TO=7genclinics@gmail.com

# Web Push (generate a matching pair once with: npm run push:generate-keys)
# Paste ONLY the key strings (no quotes). Public + private must be from the SAME generate run.
# Put real keys in .env.local (local) and Vercel Env Vars (production) — NEVER in this example file.
# After changing keys on Vercel, redeploy.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:7genclinics@gmail.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Video Conferencing — production must NOT use free meet.jit.si embedding
# (8x8 cuts those calls after ~5 minutes). Prefer 8x8 JaaS, or self-hosted Jitsi.
#
# --- Option A: 8x8 Jitsi as a Service (recommended for Vercel) ---
# From https://jaas.8x8.vc → API keys: AppID, Key ID (kid), and Private Key PEM.
JAAS_APP_ID=vpaas-magic-cookie-90d9dc7a1be2410f97c27f45933023cd
JAAS_API_KEY_ID=vpaas-magic-cookie-90d9dc7a1be2410f97c27f45933023cd/ddb69a
# Paste PEM with \n escapes, or base64-encode the whole PEM file (preferred on Vercel).
JAAS_PRIVATE_KEY=base64-or-pem-private-key
#
# Important in https://jaas.8x8.vc → API keys:
# - Use the real Key ID (…/ddb69a), NOT the JWT lab SAMPLE_APP kid.
# - Turn OFF "Allow meeting participants to join unauthenticated".
# - Do not paste a static console JWT into the app; the server mints a fresh JWT per join.
# --- Option B: self-hosted Jitsi + Prosody JWT (see deploy/jitsi/README.md) ---
# JITSI_DOMAIN=meet.your-domain.pk
# JITSI_APP_ID=apna-clinic
# JITSI_APP_SECRET=use-the-same-random-secret-as-the-jitsi-vps
#
# Deterministic appointment room names (any long random string).
JITSI_ROOM_SECRET=use-a-different-random-room-secret
# Set true only for local demos. Never enable on production Vercel.
# JITSI_ALLOW_PUBLIC_FALLBACK=true

# Cron (appointment expiry sweep — optional; dashboards also trigger sync)
CRON_SECRET=your-random-cron-secret

# Public site URL (emails + push deep links).
# Local: http://localhost:3000
# Production: use your primary Vercel URL (both deployments can share the same keys).
NEXT_PUBLIC_APP_URL=https://apnaclinic.pk
PLATFORM_FEE_PERCENT=10

# Development
NODE_ENV=development
